# ===== InfoPulse MAX Bot — Environment Variables =====
# Copy this file to `max-bot/.env` and fill in the values.

# MAX Bot token (https://dev.max.ru → your bot card)
BOT_TOKEN=your_max_bot_token_here

# Public URL of the Web App (used in mini-app buttons)
WEB_APP_URL=http://localhost:5173

# Comma-separated list of user IDs that have admin access
ADMIN_IDS=123456789

# NODE_ENV: development | production
NODE_ENV=development
