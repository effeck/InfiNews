# ===== InfiNews MAX Bot — Environment Variables =====
# Copy this file to `max-bot/.env` and fill in the values.

# ---------- Bot ----------
# MAX Bot token (https://dev.max.ru → your bot card)
BOT_TOKEN=your_max_bot_token_here

# Public URL of the Web App (used in mini-app buttons)
WEB_APP_URL=http://localhost:5173

# Comma-separated list of user IDs that have admin access
ADMIN_IDS=123456789

# NODE_ENV: development | production
NODE_ENV=development

# Set to 1 to log every incoming event to stdout. Default: 1.
LOG_EVENTS=1

# ---------- RSS ----------
# Maximum age (hours) of articles to consider. Older items are dropped.
RSS_MAX_AGE_HOURS=48

# Hard ceiling per request. Keeps slow feeds from snowballing.
RSS_MAX_TOTAL=30

# Per-feed cap (parsed items per feed before global slicing).
RSS_MAX_PER_FEED=25

# Per-feed HTTP timeout (ms).
RSS_TIMEOUT_MS=8000

# Custom User-Agent header.
RSS_USER_AGENT=InfiNewsBot/1.0 (+https://github.com/effeck/InfiNews)

# Extra RSS feeds added to the "general" bucket, comma-separated URLs.
# RSS_EXTRA=https://example.com/feed.rss,https://another.example.com/rss

# ---------- Dedup ----------
# How long to remember "already shown" articles, in days.
DEDUP_TTL_DAYS=7

# Path to a JSON file with seen-articles cache (auto-created).
DEDUP_CACHE_PATH=./data/seen.json

# Jaccard similarity threshold for fuzzy title matching (0..1).
DEDUP_SIMILARITY=0.85

# ---------- GigaChat (optional, https://developers.sber.ru/) ----------
# Set to 1 to enable GigaChat features (summaries + /ask).
GIGACHAT_ENABLED=0

# Either provide the pre-encoded Basic credential, or the raw pair.
# Option A: pre-encoded credential (Authorization header value without "Basic ").
# GIGACHAT_CREDENTIALS=...

# Option B: client_id + client_secret (we base64-encode them at runtime).
# GIGACHAT_CLIENT_ID=...
# GIGACHAT_CLIENT_SECRET=...

# Scope: GIGACHAT_API_PERS (individuals) | GIGACHAT_API_CORP (legal entities) | GIGACHAT_API_B2B
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Model: GigaChat | GigaChat-Pro | GigaChat-Max (paid).
GIGACHAT_MODEL=GigaChat

# Per-request HTTP timeout (ms).
GIGACHAT_TIMEOUT_MS=15000

# Override endpoints if Sber moves them.
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_CHAT_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions

# ---------- Webhook server (optional, off by default) ----------
# Set to 1 to start the Express webhook server defined in server.js.
# WEBHOOK_ENABLED=0
# WEBHOOK_URL=
# WEBHOOK_PORT=3001
